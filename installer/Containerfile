# CachyOS bootc installer environment
#
# A minimal CachyOS live environment whose only job is to install the CachyOS bootc image
# onto a target disk (automatically), then reboot into it.
#
# It provides: a UEFI-bootable Linux, DHCP networking, disk partitioning/formatting tools,
# `skopeo`/`podman` (to fetch and run the target image) and the auto-install logic under
# installer/stage/ wired to systemd. `bootc install` is executed from *inside the target
# image container* (the documented model), so this environment does not need bootc itself.
#
# Target device and source image are taken from the kernel command line and/or the attached
# BOOTCINSTAL config volume, e.g.:
#   bootc.install.imgref=192.168.122.1:5000/cachyos-bootc:test
#   bootc.install.device=/dev/vda
#
# This image is NOT the final OS; it is discarded after installation.

FROM docker.io/cachyos/cachyos-v3:latest AS installer

# See the main Containerfile: pacman's sandbox cannot work inside a rootless podman build,
# and its failure skips package hooks (depmod/dracut). The CachyOS mirror is pinned for the
# same reason as the main Containerfile (the default cdn77 CDN first entry serves a
# mismatched db/sig pair).
RUN sed -i '/^\[options\]/a DisableSandbox' /etc/pacman.conf \
    && printf 'Server = https://us.cachyos.org/repo/$arch/$repo\nServer = https://at.cachyos.org/repo/$arch/$repo\n' \
        > /etc/pacman.d/cachyos-mirrorlist

RUN pacman -Syu --noconfirm --needed \
        base \
        linux linux-firmware \
        dracut cpio \
        ostree libselinux skopeo podman fuse-overlayfs \
        e2fsprogs xfsprogs btrfs-progs dosfstools util-linux \
        gptfdisk parted \
        curl dhcpcd iproute2 \
        dbus dbus-glib glib2 shadow \
        openssh bubblewrap \
        zstd xz \
    && pacman -Scc --noconfirm

# Networking and identity. Mask tmp.mount so /tmp lives on the (large) live overlay, since
# the live overlay is far larger than the default tmpfs.
RUN systemctl enable systemd-networkd systemd-resolved dhcpcd \
    && systemctl mask systemd-firstboot.service tmp.mount \
    && echo "uninitialized" > /etc/machine-id \
    && ln -sf /usr/share/zoneinfo/UTC /etc/localtime

# containers-storage: the live root is an overlayfs, so the overlay driver needs
# fuse-overlayfs as its mount program (the kernel overlay driver cannot stack on
# overlayfs). Keep graphroot/runroot on the (large) live overlay rather than tmpfs.
RUN printf '[storage]\ndriver = "overlay"\nrunroot = "/var/lib/containers/run"\ngraphroot = "/var/lib/containers/storage"\n\n[storage.options.overlay]\nmount_program = "/usr/bin/fuse-overlayfs"\n' \
        > /etc/containers/storage.conf
ENV CONTAINERS_STORAGE_CONF=/etc/containers/storage.conf

# The local test registry is served over plain HTTP on the libvirt bridge.
RUN printf '[[registry]]\nlocation = "192.168.122.1:5000"\ninsecure = true\n' \
        > /etc/containers/registries.conf.d/10-local.conf

RUN printf '[Match]\nType=ether\n\n[Network]\nDHCP=yes\n' \
        > /usr/lib/systemd/network/20-wired.network

RUN printf 'L! /etc/resolv.conf - - - - /run/systemd/resolve/stub-resolv.conf\n' \
        > /usr/lib/tmpfiles.d/resolv-conf.conf

# Automatic installation: run on boot, then power off. The unit and script are provided by
# installer/stage via the build context.
COPY stage/install-bootc.sh stage/install-bootc.service /tmp/stage/
RUN install -m 0755 /tmp/stage/install-bootc.sh /usr/local/bin/install-bootc.sh \
    && install -m 0644 /tmp/stage/install-bootc.service /usr/lib/systemd/system/install-bootc.service \
    && systemctl enable install-bootc.service \
    && rm -rf /tmp/stage

# The installer's own initramfs must include virtio/storage/network drivers, the live
# squashfs support used by the ISO boot path, vfat (to read the optional BOOTCINSTAL
# config volume), and be generic (host-agnostic).
RUN printf 'hostonly=no\ncompress=zstd\nadd_dracutmodules+=" base systemd network rootfs-block fs-lib dmsquash-live dracut-systemd "\nadd_drivers+=" virtio_blk virtio_net virtio_pci vfat nls_cp437 nls_iso8859-1 "\n' \
        > /usr/lib/dracut/dracut.conf.d/10-installer.conf \
    && kver="$(ls /usr/lib/modules | head -n1)" \
    && dracut --force "/usr/lib/modules/${kver}/initramfs.img" "${kver}"

LABEL org.cachyos.bootc.role=installer
