[Unit]
Description=CachyOS bootc automatic installation
After=network-online.target systemd-networkd-wait-online.service
Wants=network-online.target
ConditionPathIsReadWrite=/

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/install-bootc.sh
# The install is long-running and must not be interrupted or rate-limited.
TimeoutStartSec=0
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
