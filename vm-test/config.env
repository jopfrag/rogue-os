# vm-test configuration — defaults for registry and image references.
#
# Sourced by vm-test scripts. Override via environment or command-line flags.
# These are the same values the old Makefile hardcoded.

# Registry host/IP visible to the VM (libvirt bridge gateway).
REGISTRY_HOST="${REGISTRY_HOST:-192.168.122.1}"
# Registry port.
REGISTRY_PORT="${REGISTRY_PORT:-5000}"
# Container name inside the registry.
REGISTRY_CONTAINER="${REGISTRY_CONTAINER:-cachyos-bootc}"
# Tag used for the test image.
REGISTRY_TAG="${REGISTRY_TAG:-test}"

# Derived image reference the guest pulls (e.g. 192.168.122.1:5000/cachyos-bootc:test).
VM_IMAGE="${VM_IMAGE:-${REGISTRY_HOST}:${REGISTRY_PORT}/${REGISTRY_CONTAINER}:${REGISTRY_TAG}}"

# Versioned image references for update/rollback tests.
VM_IMAGE_V1="${VM_IMAGE_V1:-${REGISTRY_HOST}:${REGISTRY_PORT}/${REGISTRY_CONTAINER}:v1}"
VM_IMAGE_V2="${VM_IMAGE_V2:-${REGISTRY_HOST}:${REGISTRY_PORT}/${REGISTRY_CONTAINER}:v2}"

# Installer ISO path (relative to repo root).
INSTALLER_ISO="${INSTALLER_ISO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/artifacts/cachyos-bootc-installer.iso}"
