# Configuration for ansible-pull (used by ansible-pull.service). This file is
# part of the image's /etc, so edits persist across bootc updates.
#
# The service is skipped while ANSIBLE_PULL_REPO is empty. The repository is
# executed as root: keep it public-safe (no plaintext secrets -- use
# ansible-vault) and free of internal-only details.
ANSIBLE_PULL_REPO=
ANSIBLE_PULL_BRANCH=main
ANSIBLE_PULL_PLAYBOOK=local.yml
ANSIBLE_PULL_DIR=/var/lib/ansible/pull

# Require a valid GPG signature on the checked-out commit (needs the signer's
# public key in the root keyring). Set to "no" only if you do not sign commits.
ANSIBLE_PULL_VERIFY_COMMIT=yes

# Vault password: a systemd credential named "vault" takes precedence (see the
# unit); otherwise this path is used when the file exists. Keep it mode 0600.
# ANSIBLE_VAULT_PASSWORD_FILE=/etc/ansible/vault.pw
