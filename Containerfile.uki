# Fedora Bootc 44 — Sealed Composefs + UKI + Secure Boot
#
# This Containerfile produces a signed UKI with native composefs.
# The "rw" karg makes /sysroot writable, which makes /etc and /var
# bind mounts writable without any workaround.

FROM quay.io/fedora/fedora-bootc:44 AS rootfs

RUN dnf install -y systemd-boot-unsigned systemd-ukify \
    openssh-server openssh-clients coreutils findutils which e2fsprogs \
    && dnf clean all

RUN systemctl enable sshd
RUN sed -i 's/^#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
RUN ssh-keygen -A

# Kernel command line: "rw" makes /sysroot writable so /etc and /var bind mounts work
RUN mkdir -p /usr/lib/bootc/kargs.d
RUN echo 'kargs = ["console=tty0", "console=ttyS0", "rw"]' > /usr/lib/bootc/kargs.d/00-console.toml

# Mount configuration: bind for /etc and /var
RUN mkdir -p /usr/lib/composefs
RUN echo '[etc]' > /usr/lib/composefs/setup-root-conf.toml
RUN echo 'mount = "bind"' >> /usr/lib/composefs/setup-root-conf.toml
RUN echo '' >> /usr/lib/composefs/setup-root-conf.toml
RUN echo '[var]' >> /usr/lib/composefs/setup-root-conf.toml
RUN echo 'mount = "bind"' >> /usr/lib/composefs/setup-root-conf.toml

RUN systemctl enable systemd-boot-update.service 2>/dev/null || true
RUN bootc container inspect

# Normalize timestamps for reproducible composefs digest
RUN find . -xdev \( -path ./proc -o -path ./sys -o -path ./dev -o -path ./run -o -path ./tmp \) -prune \
    -o -depth -print0 | xargs -0 -r touch -h -d @0

FROM rootfs AS split
RUN mkdir /kernel && bootc container split-kernel-and-rootfs --rootfs / --output /kernel

FROM quay.io/fedora/fedora-bootc:44 AS sealed-uki
ARG KEY_FINGERPRINT=unknown
RUN dnf install -y bootc sbsigntools systemd-ukify xz && dnf clean all
RUN --mount=type=bind,from=split,target=/target \
    --mount=type=bind,from=split,source=/kernel,target=/kernel \
    --mount=type=secret,id=secureboot_key \
    --mount=type=secret,id=secureboot_cert \
    <<EORUN
set -euo pipefail
kver=$(ls /kernel)
mkdir -p /out
bootc container ukify \
  --rootfs /target \
  --kernel-dir "/kernel/${kver}" \
  -- --output "/out/${kver}.efi" \
  --signtool sbsign \
  --secureboot-private-key /run/secrets/secureboot_key \
  --secureboot-certificate /run/secrets/secureboot_cert
EORUN

FROM split AS final
COPY --from=sealed-uki /out/*.efi /boot/EFI/Linux/
